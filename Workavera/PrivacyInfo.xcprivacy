<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app does not track users across apps or websites and includes no advertising or analytics SDKs. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  Data collection declaration:
	  Workavera is a self-hosted client. Account and content data is sent only to
	  the server deployed by the user. The developer does not collect or receive
	  this data, so the array remains empty.
	  If a developer-operated backend, crash reporting, or analytics service is
	  added later, declare the applicable NSPrivacyCollectedDataType entries here.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!--
	  Required Reason API declaration:
	  The app uses UserDefaults to store preferences such as the server address,
	  theme, and last login email. Only this app reads and writes those values,
	  under reason code CA92.1.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
